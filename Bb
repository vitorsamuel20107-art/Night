        local function ProcessarInput()
            local texto = InputField.Text if texto == "" then return end InputField.Text = "" 
            local textoMinusculo = string.lower(texto)
            if textoMinusculo == "/clear" then for _, el in pairs(ChatBox:GetChildren()) do if el:IsA("Frame") then el:Destroy() end end return end
            if textoMinusculo == "/public" or textoMinusculo == "/sair" then destinatarioAtual = nil AdicionarMensagemNaUI("Sistema", "Você voltou ao chat público.", nil, os.time()) return end
            if string.sub(textoMinusculo, 1, 3) == "/w " then
                local nomeAlvo = string.sub(texto, 4):match("^%s*(.-)%s*$")
                if nomeAlvo ~= "" then if JogadoresOnlineCache[nomeAlvo] then destinatarioAtual = nomeAlvo AdicionarMensagemNaUI("Sistema", "Chat privado com " .. nomeAlvo .. ", use /sair", nil, os.time()) else AdicionarMensagemNaUI("Sistema", "Usuário '" .. nomeAlvo .. "' offline.", nil, os.time()) end end return
            end
            EnviarMensagemFrequencia(texto, destinatarioAtual)
        end
