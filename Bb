        local function applyWeaponMods(tool)
            if not tool or not tool:IsA("Tool") then return end
            
            for _, desc in ipairs(tool:GetDescendants()) do
                if desc:IsA("ModuleScript") and desc.Name == "Cfg" then
                    local success, cfg = pcall(require, desc)
                    if success and type(cfg) == "table" then
                        
                        if not OriginalCfgValues[tool] then
                            OriginalCfgValues[tool] = {
                                Recuo = cfg.Recuo,
                                RecuoCima = cfg.RecuoCima,
                                RecuoLado = cfg.RecuoLado,
                                Espalhamento = cfg.Espalhamento,
                                TemRecuo = cfg.TemRecuo,
                                Recoil = cfg.Recoil,
                                Spread = cfg.Spread,
                                AngleX = cfg.AngleX,
                                AngleY = cfg.AngleY,
                                CameraShakingEnabled = cfg.CameraShakingEnabled,
                                TempoRecarga = cfg.TempoRecarga,
                                VelAnimRecarga = cfg.VelAnimRecarga,
                                ReloadTime = cfg.ReloadTime,
                                ReloadAnimationSpeed = cfg.ReloadAnimationSpeed
                            }
                        end

                        local orig = OriginalCfgValues[tool]

                        if NoRecoilEnabled then
                            if cfg.Recuo ~= nil then cfg.Recuo = 0 end
                            if cfg.RecuoCima ~= nil then cfg.RecuoCima = 0 end
                            if cfg.RecuoLado ~= nil then cfg.RecuoLado = 0 end
                            if cfg.Espalhamento ~= nil then cfg.Espalhamento = 0 end
                            if cfg.TemRecuo ~= nil then cfg.TemRecuo = false end
                            if cfg.Recoil ~= nil then cfg.Recoil = 0 end
                            if cfg.Spread ~= nil then cfg.Spread = 0 end
                            if cfg.AngleX ~= nil then cfg.AngleX = 0 end
                            if cfg.AngleY ~= nil then cfg.AngleY = 0 end
                            if cfg.CameraShakingEnabled ~= nil then cfg.CameraShakingEnabled = false end
                        else
                            if orig.Recuo ~= nil then cfg.Recuo = orig.Recuo end
                            if orig.RecuoCima ~= nil then cfg.RecuoCima = orig.RecuoCima end
                            if orig.RecuoLado ~= nil then cfg.RecuoLado = orig.RecuoLado end
                            if orig.Espalhamento ~= nil then cfg.Espalhamento = orig.Espalhamento end
                            if orig.TemRecuo ~= nil then cfg.TemRecuo = orig.TemRecuo end
                            if orig.Recoil ~= nil then cfg.Recoil = orig.Recoil end
                            if orig.Spread ~= nil then cfg.Spread = orig.Spread end
                            if orig.AngleX ~= nil then cfg.AngleX = orig.AngleX end
                            if orig.AngleY ~= nil then cfg.AngleY = orig.AngleY end
                            if orig.CameraShakingEnabled ~= nil then cfg.CameraShakingEnabled = orig.CameraShakingEnabled end
                        end

                        if InstantReloadEnabled then
                            if cfg.TempoRecarga ~= nil then cfg.TempoRecarga = 0 end
                            if cfg.VelAnimRecarga ~= nil then cfg.VelAnimRecarga = 999 end
                            if cfg.ReloadTime ~= nil then cfg.ReloadTime = 0.01 end
                            if cfg.ReloadAnimationSpeed ~= nil then cfg.ReloadAnimationSpeed = 99 end
                            
