        -- Helpers internos do Aim Silent
        local function getClosestAimSilentTarget()
            local best, bestDist = nil, math.huge
            local center = Camera.ViewportSize / 2
            for _, p in ipairs(Players:GetPlayers()) do
                if p == LocalPlayer then continue end
                local myTeam = LocalPlayer:GetAttribute("Team")
                local pTeam  = p:GetAttribute("Team")
                if myTeam and pTeam and myTeam == pTeam then continue end
                local char = p.Character
                if not char then continue end
                if char:GetAttribute("Dead") == true then continue end
                local part = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                if not part then continue end
                local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                if not onScreen or sp.Z <= 0 then continue end
                local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if dist < 180 and dist < bestDist then
                    bestDist = dist
                    best = part
                end
            end
            return best
        end

        local function HookAimSilent()
            if AimSilentHooked then return end
            AimSilentHooked = true

            -- Tentar hook no Bullet._performRaycast
            local bulletMod = nil
            for _, v in ipairs(getgc(true)) do
                if type(v) == "table" and rawget(v, "_performRaycast") and rawget(v, "create") and rawget(v, "new") then
                    bulletMod = v break
                end
            end

            if bulletMod then
                local origPerform = bulletMod._performRaycast
                bulletMod._performRaycast = newcclosure(function(self, spread)
                    local result = origPerform(self, spread)
                    if AimSilentEnabled then
                        local target = getClosestAimSilentTarget()
                        if target then
                            local origin = Camera.CFrame.Position
                            local dir    = (target.Position - origin).Unit
                            result.Direction = dir
                            local rayParams = RaycastParams.new()
                            rayParams.FilterType = Enum.RaycastFilterType.Exclude
                            if LocalPlayer.Character then rayParams.FilterDescendantsInstances = {LocalPlayer.Character} end
                            local range = (self.Properties and self.Properties.Range) or 500
                            local hit   = workspace:Raycast(origin, dir * range, rayParams)
                            if hit then
                                result.Distance = (hit.Position - origin).Magnitude
                                result.Hits = {{ Position = hit.Position, Instance = hit.Instance, Material = hit.Material and hit.Material.Name or "Plastic", Normal = hit.Normal or Vector3.new(0,1,0), Exit = false }}
                            end
                        end
                    end
                    return result
                end)
                SalvarNoDiario("Aim Silent: hook em Bullet._performRaycast", "SUCCESS")
            else
                -- Fallback: castMod
                local castMod
                for _, v in ipairs(getgc(true)) do
                    if type(v) == "table" and rawget(v, "cast") and rawget(v, "castThrough") then castMod = v break end
                end
                if castMod then
                    local oCast = hookfunction(castMod.cast, newcclosure(function(orig, dir, ...)
                        if AimSilentEnabled then
                            local target = getClosestAimSilentTarget()
                            if target then
                                local head = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
                                if head and (orig - head.Position).Magnitude < 15 then dir = (target.Position - orig).Unit end
                            end
                        end
                        return oCast(orig, dir, ...)
                    end))
                    local oCastThrough = hookfunction(castMod.castThrough, newcclosure(function(orig, dir, ...)
                        if AimSilentEnabled then
                            local target = getClosestAimSilentTarget()
                            if target then
                                local head = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
                                if head and (orig - head.Position).Magnitude < 15 then dir = (target.Position - orig).Unit end
                            end
                        end
                        return oCastThrough(orig, dir, ...)
                    end))
                    SalvarNoDiario("Aim Silent: fallback hook em castMod", "SUCCESS")
                end
            end
        end

        local function HookFastReload()
            if FastReloadHooked then return end
            FastReloadHooked = true

            local function boostTrack(track)
                if not track or not track:IsA("AnimationTrack") then return end
                if (track.Name or ""):lower():find("reload") then
                    pcall(function() track:AdjustSpeed(10) end)
                end
            end

            local function watchChar(char)
                if not char then return end
                local hum = char:WaitForChild("Humanoid", 5)
                if not hum then return end
                local anim = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 3)
                if anim then anim.AnimationPlayed:Connect(boostTrack) end
            end

            if LocalPlayer.Character then watchChar(LocalPlayer.Character) end
            LocalPlayer.CharacterAdded:Connect(watchChar)

            task.spawn(function()
                while task.wait(1) do
                    if not FastReloadEnabled then continue end
                    local vm = Camera:FindFirstChildWhichIsA("Model")
                    if vm then
                        local ac = vm:FindFirstChildOfClass("Animator")
                        if ac and not ac:GetAttribute("NIGHT_RHooked") then
                            ac:SetAttribute("NIGHT_RHooked", true)
                            ac.AnimationPlayed:Connect(boostTrack)
                        end
                    end
                    for _, v in ipairs(getgc(true)) do
                        if type(v) ~= "table" then continue end
                        if rawget(v, "IsReloading") ~= nil and rawget(v, "Viewmodel") ~= nil and rawget(v, "Rounds") ~= nil and not rawget(v, "__NightFR") then
                            rawset(v, "__NightFR", true)
                            local vm2 = rawget(v, "Viewmodel")
                            if type(vm2) == "table" then
                                local animObj = rawget(vm2, "Animation")
                                if animObj and type(animObj) == "table" then
                                    local origPlay = rawget(animObj, "play")
                                    if origPlay then
                                        rawset(animObj, "play", function(self2, animName, ...)
                                            local track = origPlay(self2, animName, ...)
                                            if track and type(animName) == "string" and animName:lower():find("reload") then
                                                pcall(function() track:AdjustSpeed(10) end)
                                            end
                                            return track
                                        end)
                                    end
                                end
                            end
                        end
                    end
                end
            end)
            SalvarNoDiario("Fast Reload hooked", "SUCCESS")
        end

